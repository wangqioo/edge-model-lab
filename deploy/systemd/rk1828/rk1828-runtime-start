#!/usr/bin/env bash
set -euo pipefail

DEVICE_ID="${RK1828_DEVICE_ID:-0000:01:00.0}"
FIRMWARE="${RK1828_FIRMWARE:-/lib/firmware/rknn3_rk1820.img}"
TMP_DIR="${RK1828_TMP_DIR:-/tmp/rk1828-fw}"
MODULE="${RK1828_MODULE:-/usr/lib/modules/pcie-rkep.ko}"
EXPECTED_MODULE_SHA="${RK1828_MODULE_SHA:-58b4cd6664953d560aa8fc72b6295caec2634793ba17246f32e66108fcb913b2}"

export RKNN3_NETWORK_SOCKET_FILE="${RKNN3_NETWORK_SOCKET_FILE:-/tmp/rk-mdns.ini}"

log() {
  printf '[rk1828-runtime] %s\n' "$*"
}

require_file() {
  local path="$1"
  if [ ! -f "$path" ]; then
    log "missing required file: $path"
    exit 10
  fi
}

wait_for_device_node() {
  local node="/dev/pcie-rkep-$DEVICE_ID"
  local attempt

  for attempt in $(seq 1 25); do
    if [ -e "$node" ]; then
      log "found $node"
      return 0
    fi
    echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
    sleep 1
  done

  log "device node did not appear: $node"
  exit 11
}

module_loaded() {
  lsmod | grep -q '^pcie_rkep'
}

device_online() {
  /bin/rknn-smi info 2>/dev/null | grep -q 'Online'
}

log "starting RK1828 runtime bring-up"
require_file "$MODULE"
require_file "$FIRMWARE"
require_file /bin/pcie_upgrade_tool
require_file /bin/rknn3_transfer_proxy
require_file /bin/rknn-smi

actual_module_sha="$(sha256sum "$MODULE" | awk '{print $1}')"
if [ "$actual_module_sha" != "$EXPECTED_MODULE_SHA" ]; then
  log "unexpected pcie-rkep.ko sha256: $actual_module_sha"
  log "expected: $EXPECTED_MODULE_SHA"
  exit 12
fi

if ! module_loaded; then
  log "pcie_rkep is not loaded; trying rk1828-rkep-load.service"
  systemctl start rk1828-rkep-load.service || true
fi

if ! module_loaded; then
  log "pcie_rkep is still not loaded"
  exit 13
fi

wait_for_device_node
mkdir -p "$TMP_DIR"

if device_online; then
  log "RK1828 is already Online; skipping firmware download"
else
  log "downloading firmware to $DEVICE_ID"
  timeout --foreground 120 /bin/pcie_upgrade_tool -s "$DEVICE_ID" uf "$FIRMWARE" "$TMP_DIR"
  sleep 2
fi

log "SMI after firmware step:"
/bin/rknn-smi info || true

log "starting rknn3_transfer_proxy"
exec /bin/rknn3_transfer_proxy
