[Unit]
Description=Edge RKNN Python inference service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/edge/apps/rknn_service
ExecStart=__EDGE_VENV_PYTHON__ /opt/edge/apps/rknn_service/edge_rknn_service.py --model /opt/edge/models/rk3576_resnet18_lite2.rknn --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=3
User=__EDGE_SERVICE_USER__
Group=__EDGE_SERVICE_USER__
SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
