@@ -0,0 +1,49 @@
+// Vision+LLM-only build stub.
+// The official RKNN3 v1.0.4 Qwen2.5-Omni-3B preconverted bundle includes
+// vision and LLM files only, not the audio RKNN/weight pair.
+
+#include "rknn_qwen2_5_omni_audio.h"
+
+#include <stdio.h>
+
+int read_audio(const char* path, audio_buffer_t* audio)
+{
+    (void)path;
+    (void)audio;
+    printf("Qwen2.5-Omni audio file loading is disabled in this Vision+LLM build.\n");
+    return -1;
+}
+
+int init_qwen2_5_omni_audio(rknn_qwen2_5_omni_audio_context* audio_ctx, const char* model_path,
+                            const char* weight_path, uint32_t core_mask)
+{
+    (void)audio_ctx;
+    (void)model_path;
+    (void)weight_path;
+    (void)core_mask;
+    printf("Qwen2.5-Omni audio is disabled in this Vision+LLM build.\n");
+    return -1;
+}
+
+int release_qwen2_5_omni_audio(rknn_qwen2_5_omni_audio_context* audio_ctx)
+{
+    (void)audio_ctx;
+    return 0;
+}
+
+int get_n_audio(rknn_qwen2_5_omni_audio_context* audio_ctx, int audio_len)
+{
+    (void)audio_ctx;
+    (void)audio_len;
+    return 0;
+}
+
+int inference_qwen2_5_omni_audio(rknn_qwen2_5_omni_audio_context* audio_ctx, audio_buffer_t* audio,
+                                 float16* audio_embeds)
+{
+    (void)audio_ctx;
+    (void)audio;
+    (void)audio_embeds;
+    printf("Qwen2.5-Omni audio inference is disabled in this Vision+LLM build.\n");
+    return -1;
+}
