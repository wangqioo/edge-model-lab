$ sh -c for p in python3 python; do if command -v "$p" >/dev/null 2>&1; then printf "\n## %s\n" "$p"; "$p" --version 2>&1; "$p" - <<'PY' 2>/dev/null
import sys, platform, site
print("executable=", sys.executable)
print("platform=", platform.platform())
print("paths=", sys.path[:8])
try:
    print("sitepackages=", site.getsitepackages())
except Exception as e:
    print("sitepackages_error=", e)
PY
fi; done; for p in pip3 pip; do if command -v "$p" >/dev/null 2>&1; then printf "\n## %s\n" "$p"; "$p" --version; "$p" list 2>/dev/null | head -300; fi; done

